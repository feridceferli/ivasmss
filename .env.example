# Values must be set in the process environment / Render Environment.
# The bot does not automatically load .env files. Never commit real values.
BOT_TOKEN=your_telegram_bot_token
AZE_SMS_API_KEY=your_api_key
# Same web UI runs both as a Telegram Mini App and as a browser website.
WEBAPP_URL=https://ivasmss.onrender.com/
# Render sets RENDER_EXTERNAL_URL automatically; it is used when WEBAPP_URL is not set.

# Admin notification tools
NOTIFY_GROUP_ID=-1001234567890
# Optional: leave empty to reuse BOT_TOKEN
NOTIFY_BOT_TOKEN=

# Number archive: existing private repository (initialize it with a README).
# Fine-grained token limited to that repository, Contents: Read and write.
NUMBER_ARCHIVE_GITHUB_REPO=
NUMBER_ARCHIVE_GITHUB_TOKEN=
# Empty uses the repository's default branch.
NUMBER_ARCHIVE_GITHUB_BRANCH=
NUMBER_ARCHIVE_GITHUB_PATH=numbers.txt
# Account balances, referrals, OTP counts, admin settings and unexpired leases
# are saved to this JSON file in the SAME PRIVATE GitHub repository.
# Do not set this path to a publicly accessible source repository.
USER_BACKUP_GITHUB_PATH=user_profiles.json
# The worker also syncs soon after user/settings changes. On graceful shutdown
# it attempts a last flush. This is best-effort, not a zero-loss database.
NUMBER_ARCHIVE_SYNC_SECONDS=60
# Optional persistent volume mount. Render free web services have ephemeral storage:
# files under a local folder will disappear on instance replacement unless
# the private GitHub backup above or a durable database is configured.
DB_FOLDER=

# WhatsApp Cloud API, admin-only opt-in smoke test. Keep real secrets in Render.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEST_RECIPIENT=
WA_GRAPH_VERSION=v25.0

# API sales products are entered from the authenticated Admin panel.
# Private catalog: DB_FOLDER/api_sales_private.json; purchases: users.json.
# Both are included in USER_BACKUP_GITHUB_PATH when the backup repo is PRIVATE.
# Never put sale credentials or this backup in your public source repository.

# API sales group digest: every 15 minutes while API Sales is visible and active.
# Leave blank to use the existing OTP Telegram group.
# The bot must be a member and have permission to post messages.
API_SALES_GROUP_ID=
